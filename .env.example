# =============================================================================
# Imposter Game — root environment template
# Copy to .env and fill in real values. Never commit .env.
# NEXT_PUBLIC_* and EXPO_PUBLIC_* are shipped to the client — never put a
# secret behind those prefixes.
# =============================================================================

NODE_ENV=development

# ---- backend (apps/server) ----
# Reachable from the web app in dev, and from the mobile app over your LAN.
PORT=4000
# Socket.IO server. `pnpm dev:server` binds 0.0.0.0 so a phone can reach it.
SERVER_HOST=0.0.0.0
# Comma-separated allow-list of browser origins. Leave blank in dev to allow all.
CORS_ORIGIN=

# ---- voice (LiveKit) ----
# Optional. Leave blank and voice is simply reported as unavailable — chat still works.
# Get these from cloud.livekit.io → Settings → Keys (free tier is enough).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- web (apps/web) — PUBLIC ----
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- mobile (apps/mobile) — PUBLIC ----
# On a physical device "localhost" means the device itself. Use your machine's
# LAN IP (e.g. http://192.168.1.20:4000) or a tunnel.
EXPO_PUBLIC_SERVER_URL=http://localhost:4000

# No database, auth or cache is configured yet. Add those variables only when
# the code that reads them exists.
