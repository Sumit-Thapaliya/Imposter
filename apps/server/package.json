{
  "name": "@imposter-game/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative real-time server for the Imposter Game (Fastify + Socket.IO).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.1",
    "livekit-server-sdk": "^2.19.2",
    "socket.io": "^4.8.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
