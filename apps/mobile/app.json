{
  "expo": {
    "name": "Imposter Game",
    "slug": "imposter-game",
    "version": "0.1.0",
    "icon": "./assets/icon/icon.png",
    "orientation": "portrait",
    "scheme": "impostergame",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0618",
    "splash": {
      "image": "./assets/icon/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0618"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.impostergame.app"
    },
    "android": {
      "package": "com.impostergame.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-icon.png",
        "backgroundColor": "#160B2E"
      },
      "splash": {
        "image": "./assets/icon/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B0618"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0618",
          "image": "./assets/icon/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/icon/favicon.png"
    }
  }
}
